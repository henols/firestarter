
# Everything under .claude/ is local runtime state (settings, gsd-core, channels,
# worktrees) EXCEPT hand-authored skills, which are project tooling and are shared.
.claude/*
!.claude/skills/
.claude/skills/*/scripts/__pycache__/
# find-skills is marketplace-installed (carries source.json — reinstall, don't vendor).
.claude/skills/find-skills/
# skill-creator is marketplace-installed via `npx skills` (2026-08-21). That installer
# uses a newer layout than find-skills: real files under .agents/skills/<name>/ with a
# symlink at .claude/skills/<name>. Reinstall, don't vendor:
#   npx skills add anthropics/skills@skill-creator
.claude/skills/skill-creator
.agents/
# skills-lock.json is the `npx skills` manifest. Root-level tool artifact — this repo
# tracks only .planning/ and .claude/, so it stays local like package*.json.
skills-lock.json
.pio/
# Generated by .devcontainer/post-create.sh — keeps PlatformIO IDE working from repo root
platformio.ini

# Python bytecode (codegen tools etc.)
__pycache__/
*.py[cod]

# v1.7 milestone substrate — gitignore everything under .planning/v1.7/ except .md files
# (raw chat dumps, upstream clone, photo binaries stay local; distilled .md commits)
.planning/v1.7/**
!.planning/v1.7/**/
!.planning/v1.7/**/*.md
# Local working clone of the upstream RURP repo. BOTH forms are required: the
# trailing-slash pattern matches the directory, the bare path matches the
# GITLINK git records for a nested repo -- and it was the missing bare form
# that let this path get committed as an orphaned submodule in c502fc39.
.planning/v1.7/upstream-rurp/
.planning/v1.7/upstream-rurp

# firestarter dev-diagnostic run output (write-cycle / consistency-check).
# New runs land under firestarter-runs/; the bare-prefixed patterns cover
# folders left over from before they were grouped under a parent dir.
firestarter-runs/
consistency-check-*/
write-cycle-*/

# Knowledge-graph output (graphify / gsd-graphify). Regenerable from the tree,
# and the payloads are large: graph.json is ~23 MB in each location plus ~24 MB
# of graphify-out/cache/. Only the distilled .planning/graphs/GRAPH_REPORT.md is
# tracked; graphify-out/ at the repo root is scratch output that duplicates it.
.planning/graphs/graph.json
.planning/graphs/.last-build-snapshot.json
graphify-out/

# Researcher fetch cache (web/Context7 responses). Regenerable, and not evidence.
.planning/research/.cache/
.planning/milestones/*-research/.cache/

# Extra git worktrees of the two sub-repos, checked out alongside the tracked
# gitlinks for parallel branch work. Temporary by nature — never gitlinked.
firestarter_app_py32/
firestarter_py32_ci/
chip-test/

# Bench artifacts that land at the repo root instead of under a run directory:
# raw chip dumps (chip-test/ above holds `dev test` reports plus the v1.21
# Phase 115 fresh-machine onboarding transcripts).
/*.bin
node_modules
# The line-16 comment already says root package*.json "stays local", but only
# skills-lock.json ever got a rule. Root-anchored so nested manifests are unaffected.
/package.json
/package-lock.json

# v1.34 host-arm worktree root (two firestarter_app worktrees + venvs, Phase 160 D-06).
/.v1.34-arms/

# GSD runtime state. Regenerable and session-local, never tracked: state.json is
# a cache scraped from STATE.md's body, milestone.lock is a per-session phase lock
# carrying a pid, and .gsd/ holds dispatch sentinels. Same class as .claude/* above.
.planning/state.json
.planning/milestone.lock
.gsd/
